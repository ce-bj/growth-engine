# 本地聊天后端
CHAT_SERVER_PORT=8787

# ===== 推荐：对接 agents-workspace 多 Agent（主 Agent + 产品详情页子 Agent）=====
AGENT_PYTHON_URL=http://127.0.0.1:8790
AGENT_BRIDGE_PORT=8790
PYTHON_AGENT_MODULE=ai_ops_assistant
PRODUCT_DETAIL_AGENT_MODULE=b2b_portal_agent
DEMO_FRONTEND_ORIGIN=http://localhost:5174

# vveai / OpenAI 兼容 API（必填，勿提交到 Git）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.vveai.com/v1
OPENAI_MODEL=DeepSeek-V4-Pro
OPENAI_THINKING_ENABLE=true
# 前端右上角模型下拉（逗号分隔，第一项可与 OPENAI_MODEL 相同）
OPENAI_MODEL_OPTIONS=DeepSeek-V4-Pro,qwen3.6-plus,gpt-4o

# 内容生成加速（可选）：独立模型 + 每批模块数（默认 10，最大 16）
# CONTENT_GEN_MODEL=qwen3.5-35b-a3b
# CONTENT_GEN_BATCH_SIZE=10

# ===== 识图加速（与对话模型解耦，强烈建议配置）=====
# 对话仍用 OPENAI_MODEL / 前端所选；识图默认 qwen-vl-plus（轻量多模态）
# VISION_MODEL=qwen-vl-plus
# VISION_MODEL_DEFAULT=qwen-vl-plus
# VISION_TIMEOUT_SEC=45
# IMAGE_ANALYSIS_TIMEOUT_SEC=50
# IMAGE_ANALYSIS_FALLBACK_TIMEOUT_SEC=45
# ENABLE_GENERATION_BRIEF_GATE=false
# VISION_PROMPT_MODE=fast

# ===== 会话日志（排查 / 评估）=====
# 默认开启，落盘 demo-project/logs/chat-sessions/
CHAT_SESSION_LOG_ENABLE=true
# CHAT_SESSION_LOG_DIR=demo-project/logs/chat-sessions
# CHAT_SESSION_LOG_MAX_CHARS=120000

# ===== Langfuse 可观测（同事机自托管）=====
# Bridge 启动时配置 OTEL → Langfuse OTLP；Agent 使用 TracingMiddleware
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_BASE_URL=http://172.25.171.180:3001
# 可选：覆盖默认 OTLP 地址（默认 = BASE_URL + /api/public/otel/v1/traces）
# LANGFUSE_OTLP_URL=http://172.25.171.180:3001/api/public/otel/v1/traces
# LANGFUSE_ENV=local-demo
# OTEL_SERVICE_NAME=ai-ops-assistant-demo
# 本地默认 simple（即时可见）；生产可改 batch
# LANGFUSE_OTEL_PROCESSOR=simple

# ===== 可选：对接公司 AgentScope 2.0 平台（与上面二选一）=====
# AGENT_PYTHON_URL=
# AGENTSCOPE_BASE_URL=http://172.25.171.180:8000
# AGENTSCOPE_USER_ID=product-publish-demo
# AGENTSCOPE_AGENT_ID=
# AGENTSCOPE_SESSION_ID=
