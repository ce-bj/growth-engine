      "contentModules": [
        {
          "id": 0,
          "name": "产品概述",
          "layer": "A",
          "priority": "required",
          "outputShape": "overview",
          "fieldTarget": "layerA.overview",
          "guidance": null,
          "note": "表外 baseline，各行业默认包含"
        },
        {
          "id": 1,
          "name": "产品标题与核心卖点",
          "layer": "A",
          "priority": "required",
          "outputShape": "title_selling_points",
          "fieldTarget": "layerA.title",
          "guidance": "标题需包含发电机组型号+核心功能+应用领域，突出技术参数优势"
        },
        {
          "id": 2,
          "name": "产品规格参数表",
          "layer": "B",
          "priority": "required",
          "outputShape": "spec_table",
          "fieldTarget": "layerB.sections[specs]",
          "guidance": "必须包含：尺寸、重量、功率、精度、产能等关键技术参数，表格形式呈现"
        },
        {
          "id": 3,
          "name": "产品功能/性能介绍",
          "layer": "B",
          "priority": "required",
          "outputShape": "text",
          "fieldTarget": "layerB.sections[features]",
          "guidance": "分点列出核心功能，突出性能指标，配性能曲线图或数据对比"
        },
        {
          "id": 4,
          "name": "应用场景/使用案例",
          "layer": "B",
          "priority": "required",
          "outputShape": "scenario_cards",
          "fieldTarget": "layerB.sections[scenarios]",
          "guidance": "展示典型应用案例，配现场使用图片或视频"
        },
        {
          "id": 5,
          "name": "产品图片/视频展示",
          "layer": "A",
          "priority": "required",
          "outputShape": "image_meta",
          "fieldTarget": "layerA.media",
          "guidance": "多角度高清图片（整体/细节/操作界面），产品运行视频",
          "note": "生成 alt/说明文案，素材由用户上传"
        },
        {
          "id": 6,
          "name": "技术原理/工艺流程",
          "layer": "B",
          "priority": "required",
          "outputShape": "text",
          "fieldTarget": "layerB.sections[technology]",
          "guidance": "用图解方式说明工作原理、工艺流程"
        },
        {
          "id": 7,
          "name": "质量认证/检测报告",
          "layer": "B",
          "priority": "required",
          "outputShape": "bullet_list",
          "fieldTarget": "layerB.sections[certifications]",
          "guidance": "展示ISO、CE等认证，第三方检测数据"
        },
        {
          "id": 11,
          "name": "包装与物流信息",
          "layer": "B",
          "priority": "required",
          "outputShape": "text",
          "fieldTarget": "layerB.sections[packaging]",
          "guidance": "说明包装方式、运输方式、交货周期"
        },
        {
          "id": 12,
          "name": "安装/使用指南",
          "layer": "B",
          "priority": "required",
          "outputShape": "step_list",
          "fieldTarget": "layerB.sections[installation]",
          "guidance": "提供安装条件、调试流程、操作培训"
        },
        {
          "id": 13,
          "name": "常见问题FAQ",
          "layer": "B",
          "priority": "required",
          "outputShape": "faq_list",
          "fieldTarget": "layerB.sections[faq]",
          "guidance": "列出选型、操作、维护等常见问题"
        },
        {
          "id": 15,
          "name": "对比优势/竞品分析",
          "layer": "B",
          "priority": "recommended",
          "outputShape": "comparison_table",
          "fieldTarget": "layerB.sections[comparison]",
          "guidance": "与竞品对比，突出性价比、服务优势"
        },
        {
          "id": 17,
          "name": "安全注意事项",
          "layer": "B",
          "priority": "required",
          "outputShape": "bullet_list",
          "fieldTarget": "layerB.sections[safety]",
          "guidance": "列出操作安全规范、防护装置"
        },
        {
          "id": 20,
          "name": "技术文档下载",
          "layer": "B",
          "priority": "recommended",
          "outputShape": "doc_links",
          "fieldTarget": "layerB.sections[documents]",
          "guidance": "提供说明书、图纸下载",
          "note": "富文本入口 + 产品附件占位"
        },
        {
          "id": 24,
          "name": "产品迭代/更新日志",
          "layer": "B",
          "priority": "recommended",
          "outputShape": "changelog",
          "fieldTarget": "layerB.sections[changelog]",
          "guidance": "记录升级历史、改进点"
        },
        {
          "id": 25,
          "name": "兼容性/适配信息",
          "layer": "B",
          "priority": "recommended",
          "outputShape": "spec_table",
          "fieldTarget": "layerB.sections[compatibility]",
          "guidance": "说明适配范围、配套件"
        },
        {
          "id": 26,
