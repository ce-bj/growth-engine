        "options": ["工业控制", "消费电子配套", "通信能源", "其他"]
      },
      "advantages": {
        "options": ["接口兼容", "功耗/效率", "认证标准", "供货周期", "其他"]
      }
    },
    "消费品食品": {
      "scenarios": {
        "options": ["零售渠道", "餐饮供应", "电商直销", "出口贸易", "其他"]
      },
      "advantages": {
        "options": ["成分/营养", "包装规格", "口感/体验", "资质许可", "其他"]
