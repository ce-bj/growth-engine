[
  {
    "preset_id": "precision",
    "version": "1.0",
    "name": "精工 · 产品方案",
    "page_type": "产品营销",
    "defaults": {
      "goal": "获取报价",
      "layout": "split",
      "form_ref": "lead_form",
      "brand_ref": "current_site",
      "hero": {
        "visible": true,
        "image_slot": "hero"
      },
      "footer": {
        "visible": true
      }
    },
    "design_spec": {
      "composition": "左侧产品价值主张，右侧工程产品主图；克制、清晰的工业风格",
      "narrative": "能力→场景→服务支持→询价",
      "imageLanguage": "产品实物或明确标识的工业示意",
      "heroColumns": "1.08fr 1fr",
      "headingWidth": "430px",
      "sectionSpace": 45,
      "mobile": "按阅读顺序单栏重排，不缩小整页、不隐藏表单字段"
    },
    "components": [
      {
        "slot_id": "s0",
        "kind": "products",
        "title": "产品能力",
        "defaults_ref": "component:products@1.0"
      },
      {
        "slot_id": "s1",
        "kind": "text",
        "title": "应用场景",
        "defaults_ref": "component:text@1.0"
      },
      {
        "slot_id": "s2",
        "kind": "features",
        "title": "技术支持",
        "defaults_ref": "component:features@1.0"
      },
      {
        "slot_id": "s3",
        "kind": "form",
        "title": "联系与询价",
        "defaults_ref": "component:form@1.0"
      }
    ],
    "requirements": [
      {
        "id": "product-binding",
        "target_kinds": [
          "products",
          "comparison"
        ],
        "predicate": "selected_authorized_products_count >= 1",
        "on_missing": "ask_user",
        "blocks": [
          "generate_affected_content",
          "publish"
        ]
      },
      {
        "id": "form-binding",
        "target_kinds": [
          "form",
          "cta"
        ],
        "predicate": "valid_form_config",
        "on_missing": "ask_user",
        "blocks": [
          "publish"
        ]
      }
    ],
    "override_policy": "confirmed_user_values_win",
    "facts_policy": "evidence_only"
  },
