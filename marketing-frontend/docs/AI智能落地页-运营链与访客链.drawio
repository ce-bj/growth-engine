          <mxGeometry x="642" y="1360" width="150" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="use-scenes" name="使用场景">
    <mxGraphModel dx="1461" dy="823" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sc-t" value="使用场景：谁来调用，访客怎么看到" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1B365D;" parent="1" vertex="1">
          <mxGeometry x="40" y="16" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sc-sec0" value="一、谁、在什么情况下、怎么用（触发生成）" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fontColor=#1B365D;" parent="1" vertex="1">
          <mxGeometry x="40" y="68" width="560" height="22" as="geometry" />
        </mxCell>
        <mxCell id="sc-who1" value="客户 / 运营&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;何时：要给某一类采购做承接页&lt;br&gt;怎么用：打开生成界面。有 Ads/GSC 则选词；没有则直接推建议意图。确认方案后发布。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fillColor=#1B365D;strokeColor=#1B365D;strokeWidth=1.5;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="40" y="96" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sc-who2" value="SEO&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;何时：做内链，但还没有对应意图页&lt;br&gt;怎么用：调用本功能，一次出「页 + 锚文本/内链」。已有页则只插链，不再出页。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fillColor=#1B365D;strokeColor=#1B365D;strokeWidth=1.5;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="306" y="96" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sc-who3" value="内容运营&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;何时：发文 / 社媒需要可点的承接页&lt;br&gt;怎么用：有现成 URL 就引用；没有就调用本功能出页再插链。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fillColor=#1B365D;strokeColor=#1B365D;strokeWidth=1.5;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="572" y="96" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sc-who4" value="优化师（可选）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;何时：广告需要到达页&lt;br&gt;怎么用：通常只复制已发布真 URL 去贴。要新页才进生成。不改广告账户。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fillColor=#F7FAFC;strokeColor=#A0AEC0;strokeWidth=1.5;fontSize=12;fontColor=#1A202C;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="838" y="96" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sc-who5" value="其他 AI Agent&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;何时：诊断到某词/某意图没有承接页，或获客任务需要落地 URL&lt;br&gt;怎么用：下任务调用本功能，不让客户直接对 Agent。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fillColor=#FAF5FF;strokeColor=#6B46C1;strokeWidth=1.5;fontSize=11;fontColor=#1A202C;" parent="1" vertex="1">
          <mxGeometry x="1104" y="96" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sc-who6" value="定时任务（自闭环）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;何时：定期扫新词或意图缺口&lt;br&gt;怎么用：有 Ads/GSC 则拉新词；没有则按档案推意图。走同一套出页。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fillColor=#FFFAF0;strokeColor=#DD6B20;strokeWidth=2;fontSize=11;fontColor=#1A202C;" parent="1" vertex="1">
          <mxGeometry x="1370" y="96" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sc-hub" value="本功能：意图 → 方案 → 出稿 → 发布&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;六类调用都进这一条。有词用词；没词直接推建议意图类型。不手填关键词。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fillColor=#EBF8FF;strokeColor=#2B6CB0;strokeWidth=2;fontSize=13;fontColor=#1B365D;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="208" width="1580" height="48" as="geometry" />
        </mxCell>
