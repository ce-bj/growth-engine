        <mxCell id="usl-title" value="使用场景 泳道图：每个角色对接哪些系统" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1B365D;" parent="1" vertex="1">
