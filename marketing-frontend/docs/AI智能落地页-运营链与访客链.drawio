        </mxCell>
        <mxCell id="usl-sub" value="「后台泳道」整页在这里收成子流程「AI营销页生成能力」。本页只画各角色怎么接到系统；线不跨组、不斜穿。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=0;fontColor=#4A5568;" parent="1" vertex="1">
          <mxGeometry x="130" y="50" width="1200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="usl-leg1" value="AI营销页生成能力&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;子流程 = 后台泳道整页&lt;/font&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EBF8FF;strokeColor=#2B6CB0;strokeWidth=2;fontSize=11;fontStyle=1;fontFamily=Microsoft YaHei;" parent="1" vertex="1">
          <mxGeometry x="130" y="76" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="usl-leg2" value="虚线列 / 虚线框&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;外部系统，本产品不改账户&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F7FAFC;strokeColor=#A0AEC0;strokeWidth=1.5;fontSize=11;fontFamily=Microsoft YaHei;dashed=1;" parent="1" vertex="1">
